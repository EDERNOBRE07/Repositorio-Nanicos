rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Candidates Collection Rules
    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if isValidId(candidateId);
    }

    // Deadlines Collection Rules
    match /deadlines/{deadlineId} {
      allow read: if true;
      allow write: if isValidId(deadlineId);
    }

    // Reports Collection Rules
    match /reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }
  }
}
