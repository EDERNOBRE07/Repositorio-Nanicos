{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "Political candidate profile with active media agenda and municipal mapping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "string" },
        "urnName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "email": { "type": "string" },
        "party": { "type": "string", "enum": ["Cidadania", "PSDB"] },
        "status": { "type": "string", "enum": ["Em Campanha", "Não Iniciada", "Pausada"] },
        "photoUrl": { "type": "string" },
        "mediaCoordinatorName": { "type": "string" },
        "mediaCoordinatorWhatsApp": { "type": "string" },
        "professionalBackground": { "type": "string" },
        "areasOfInterest": { "type": "string" },
        "teams": { "type": "string" },
        "family": { "type": "string" },
        "groups": { "type": "string" },
        "trajectory": { "type": "string" },
        "politicalFlags": { "type": "string" },
        "keyContacts": { "type": "array" },
        "publications": { "type": "array" },
        "mappings": { "type": "array" },
        "lastSaved": { "type": "string" }
      },
      "required": ["id", "name", "number"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "Electoral deadline with status tracking and days remaining countdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "daysRemaining": { "type": "integer" },
        "status": { "type": "string", "enum": ["Concluído", "Pendente", "Crítico"] },
        "category": { "type": "string", "enum": ["Convenção", "Registro", "Propaganda", "Prestação de Contas", "Outro"] }
      },
      "required": ["id", "title", "date", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "Strategic political report generated by AI analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "candidateId": { "type": "string" },
        "candidateName": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "title", "createdAt", "content"]
    }
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Collection of candidates data"
    },
    "/deadlines/{deadlineId}": {
      "schema": "Deadline",
      "description": "Collection of election deadline milestones"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of generated strategic reports"
    }
  }
}
